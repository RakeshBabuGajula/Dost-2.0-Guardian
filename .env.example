# DOST Guardian 2.0 Environment Configuration Template
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=YOUR_PRODUCTION_JWT_SECRET_KEY_CHANGE_ME

# Backend Service
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000/api/v1/ws/operations

# Database Configuration (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/dost_guardian
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache & Coordination
REDIS_URL=redis://REDIS_HOST:6379/0

# Security & CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
